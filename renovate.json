{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "reviewers": ["Rawrnekton"],
  "ignorePaths": ["ansible/**"],
  "enabledManagers": ["kustomize", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)kustomization\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+tag:\\s*(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions in GitHub workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+version=(?<currentValue>[^\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "kustomize repo also tags api/, kyaml/ and cmd/config/; only use kustomize/ releases",
      "matchPackageNames": ["kubernetes-sigs/kustomize"],
      "extractVersion": "^kustomize/v(?<version>.+)$"
    },
    {
      "description": "Require manual review for infrastructure updates",
      "matchFileNames": ["argo/infra/**"],
      "automerge": false
    },
    {
      "description": "Auto-merge service updates after checks pass",
      "matchFileNames": ["argo/services/**"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Disable updates for Minecraft - manually managed",
      "matchPackageNames": ["itzg/minecraft-server"],
      "enabled": false
    },
    {
      "description": "Copperforge bumps its own tag from its build workflow",
      "matchPackageNames": ["ghcr.io/rawrnekton/copperforge"],
      "enabled": false
    }
  ]
}
