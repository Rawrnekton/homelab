        "w": 4,
        "h": 4
      },
      "id": 14
    },
    {
      "type": "stat",
      "title": "Fullest conntrack",
      "description": "When the connection tracking table is full, the kernel drops new connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
