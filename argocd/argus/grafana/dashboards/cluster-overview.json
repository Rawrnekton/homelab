    {
      "type": "timeseries",
      "title": "CPU by namespace",
      "description": "CPU cores used. 1 = one full core.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{cluster=\"$cluster\",container!=\"\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{namespace}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
