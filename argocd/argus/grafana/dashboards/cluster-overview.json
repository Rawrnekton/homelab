      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(node_nf_conntrack_entries{cluster=\"$cluster\"} / node_nf_conntrack_entries_limit{cluster=\"$cluster\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
